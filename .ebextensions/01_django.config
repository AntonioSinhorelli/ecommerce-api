option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: ecommerce.settings
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
  aws:elasticbeanstalk:container:python:
    WSGIPath: ecommerce.wsgi:application
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static

container_commands:
  00_pasta_dados:
    # Pasta do banco SQLite (usada quando não há RDS). Fica fora do código,
    # então os dados não se perdem a cada deploy.
    command: "mkdir -p /var/app/data"
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py collectstatic --noinput"
  03_criar_admin:
    # Cria/atualiza o superusuário a partir das variáveis DJANGO_SUPERUSER_*
    command: "source /var/app/venv/*/bin/activate && python3 manage.py criar_admin"
    leader_only: true
  04_permissoes:
    # Os comandos acima rodam como root; o site roda como "webapp" e precisa gravar no banco.
    command: "chown -R webapp:webapp /var/app/data && chmod 775 /var/app/data && chmod 664 /var/app/data/db.sqlite3"
