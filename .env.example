# Copie para .env e ajuste. O .env NUNCA deve ir para o GitHub nem para o app.zip.
SECRET_KEY=troque-por-uma-chave-gerada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Superusuário criado por: python manage.py criar_admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@ecommerce.com
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# MySQL local (opcional). Sem estas variáveis o projeto usa SQLite.
# MYSQL_DATABASE=ecommerce
# MYSQL_USER=root
# MYSQL_PASSWORD=senha
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
